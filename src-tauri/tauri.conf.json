{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ignite",
  "version": "1.5.0",
  "identifier": "com.ignite.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ignite",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#14100E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://*.steamstatic.com https://images.igdb.com https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; media-src 'self' blob: asset: http://asset.localhost https://*.steamstatic.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://*.steamstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzBDQjY3NjY2M0Q0NkQKUldSdDFHTm1aOHZBYlFBZ29IdmFKdnVZbUlWRnRIRGx5M0VHKzNwTXBhUHBGWktXMkNSVjY5U1cK",
      "endpoints": ["https://github.com/Gen0miX/ignite/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ludotheque",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Tous tes jeux PC au même endroit",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp"
      }
    }
  }
}
